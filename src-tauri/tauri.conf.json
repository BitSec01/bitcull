{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Culling",
  "version": "0.1.0",
  "identifier": "app.culling.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Culling",
        "width": 1500,
        "height": 950,
        "minWidth": 1080,
        "minHeight": 700,
        "resizable": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' photo: http://photo.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": ["models/*"],
    "shortDescription": "Automatic photo culling",
    "longDescription": "Scores photos for sharpness, exposure and eye state, groups burst frames, and resolves your picks back to the matching RAW files."
  }
}
